{
  "name": "galreview-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "千知万理 GalReview Windows 桌面客户端",
  "main": "main.js",
  "author": "GalReview",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.galreview.desktop",
    "productName": "千知万理",
    "copyright": "© 2026 GalReview",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "signAndEditExecutable": true,
      "sign": "./build/sign.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "千知万理",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon-48.png",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "allowScripts": {
    "electron": "true",
    "electron-builder": "true"
  }
}
